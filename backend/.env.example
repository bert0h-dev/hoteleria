# Servidor
PORT=3000
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5180

# Base de datos (Neon)
# Conexión con pooler: la usa la aplicación
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/hoteleria?sslmode=verify-full"
# Conexión directa: la usa Prisma para migraciones
DIRECT_URL="postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/hoteleria?sslmode=verify-full"
