# Servidor
PORT=3000
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5180

# Base de datos (Neon)
# Conexión con pooler: la usa la aplicación
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# Conexión directa (sin -pooler): la usa Prisma para migraciones
DIRECT_URL="postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# JWT (genera el secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=cambia-este-secreto
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Datos iniciales (solo desarrollo)
SEED_HOTEL_NAME="Mi Hotel"
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL=correo@gmail.com
SEED_ADMIN_PASSWORD=a1234
