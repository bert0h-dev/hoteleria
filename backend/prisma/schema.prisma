// Esquema de la base de datos (PostgreSQL en Neon).
// Convención: modelos y campos en inglés (camelCase); tablas y columnas en snake_case.
// Las tablas de negocio llevan hotelId para soportar varios hoteles en el futuro.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RECEPTION
  HOUSEKEEPING

  @@map("role")
}

model Hotel {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  legalName String?  @map("legal_name")
  taxId     String?  @map("tax_id")
  address   String?
  phone     String?
  email     String?
  timezone  String   @default("America/Mexico_City")
  currency  String   @default("MXN") @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users        User[]
  settings     HotelSettings?
  roomTypes    RoomType[]
  rooms        Room[]
  statusLogs   RoomStatusLog[]
  guests       Guest[]
  taxProfiles  GuestTaxProfile[]
  reservations Reservation[]
  ratePeriods  RatePeriod[]
  stayCharges  StayCharge[]

  @@map("hotels")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  hotelId        String    @map("hotel_id") @db.Uuid
  name           String
  email          String    @unique
  passwordHash   String    @map("password_hash")
  phone          String?
  /// Número de empleado (opcional), único dentro del hotel.
  employeeNumber String?   @map("employee_number")
  /// Fecha de ingreso laboral (distinta de createdAt, el alta en el sistema).
  hireDate       DateTime? @map("hire_date") @db.Date
  role           Role
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  hotel                 Hotel           @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  refreshTokens         RefreshToken[]
  statusChanges         RoomStatusLog[] @relation("StatusChangedBy")
  reservationsCreated   Reservation[]   @relation("ReservationCreatedBy")
  reservationsCancelled Reservation[]   @relation("ReservationCancelledBy")
  checkIns              Reservation[]   @relation("ReservationCheckedInBy")
  checkOuts             Reservation[]   @relation("ReservationCheckedOutBy")
  stayCharges           StayCharge[]
  cleanings             RoomStatusLog[] @relation("CleanedBy")
  roomsCleaned          Room[]          @relation("LastCleanedBy")

  @@unique([hotelId, employeeNumber])
  @@index([hotelId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  /// true si se revocó al rotarlo (se cambió por uno nuevo). Volver a usar
  /// un token rotado indica robo; uno revocado por logout o cambio de
  /// contraseña solo se rechaza.
  rotated   Boolean   @default(false)
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE

  @@map("room_status")
}

enum Amenity {
  WIFI
  AIR_CONDITIONING
  TV
  MINIBAR
  JACUZZI
  SEA_VIEW
  BALCONY
  SAFE
  COFFEE_MAKER
  WORKSPACE
  PARKING
  PET_FRIENDLY

  @@map("amenity")
}

/// Configuración de tarifas y horarios del hotel (una por hotel).
/// Los porcentajes son enteros: 15 = 15 % del precio por noche.
model HotelSettings {
  hotelId               String   @id @map("hotel_id") @db.Uuid
  hourlyRatePercent     Int      @default(15) @map("hourly_rate_percent")
  minHours              Int      @default(3) @map("min_hours")
  dayRatePercent        Int      @default(120) @map("day_rate_percent")
  dayDurationHours      Int      @default(24) @map("day_duration_hours")
  weekRatePercent       Int      @default(600) @map("week_rate_percent")
  /// Horario de la modalidad por noche, formato HH:mm.
  checkInTime           String   @default("15:00") @map("check_in_time") @db.VarChar(5)
  checkOutTime          String   @default("12:00") @map("check_out_time") @db.VarChar(5)
  /// Si la estancia por horas cuesta más que el día completo, se cobra el día.
  capHourlyAtDayRate    Boolean  @default(true) @map("cap_hourly_at_day_rate")
  /// Impuestos (los precios ya los incluyen; solo se desglosan). En %.
  vatPercent            Float    @default(16) @map("vat_percent")
  lodgingTaxPercent     Float    @default(3) @map("lodging_tax_percent")
  /// Edad máxima para considerarse niño.
  childMaxAge           Int      @default(12) @map("child_max_age")
  /// Siguiente número de folio de reserva (R-000001…).
  nextReservationNumber Int      @default(1) @map("next_reservation_number")
  /// Días de la semana con ajuste de precio (0 = domingo … 6 = sábado).
  weekdayAdjustDays     Int[]    @default([]) @map("weekday_adjust_days")
  /// Ajuste en % para esos días (p. ej. 15 = +15 %). No aplica en temporada.
  weekdayAdjustPercent  Int      @default(0) @map("weekday_adjust_percent")
  /// Minutos de tolerancia antes de sugerir cargo por entrada anticipada
  /// o salida tardía.
  graceMinutes          Int      @default(30) @map("grace_minutes")
  updatedAt             DateTime @updatedAt @map("updated_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("hotel_settings")
}

model RoomType {
  id             String    @id @default(uuid()) @db.Uuid
  hotelId        String    @map("hotel_id") @db.Uuid
  name           String
  description    String?
  maxAdults      Int       @map("max_adults")
  maxChildren    Int       @default(0) @map("max_children")
  /// Precio base por noche, en pesos enteros (impuestos incluidos).
  nightlyRate    Int       @map("nightly_rate")
  /// Adultos incluidos en el precio; los demás pagan el cargo extra.
  includedAdults Int       @default(2) @map("included_adults")
  /// Cargo por persona extra por noche/día, en pesos enteros.
  extraAdultRate Int       @default(0) @map("extra_adult_rate")
  extraChildRate Int       @default(0) @map("extra_child_rate")
  amenities      Amenity[] @default([])
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  hotel              Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  rooms              Room[]
  reservations       Reservation[]
  bookedReservations Reservation[] @relation("BookedRoomType")

  @@unique([hotelId, name])
  @@map("room_types")
}

model Room {
  id              String     @id @default(uuid()) @db.Uuid
  hotelId         String     @map("hotel_id") @db.Uuid
  roomTypeId      String     @map("room_type_id") @db.Uuid
  number          String
  floor           Int
  status          RoomStatus @default(AVAILABLE)
  notes           String?
  isActive        Boolean    @default(true) @map("is_active")
  lastCleanedAt   DateTime?  @map("last_cleaned_at")
  lastCleanedById String?    @map("last_cleaned_by_id") @db.Uuid
  /// En Mantenimiento / Fuera de servicio: último día (inclusive) que estará
  /// bloqueada. Null en Fuera de servicio = indefinido.
  blockedUntil    DateTime?  @map("blocked_until") @db.Date
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  hotel         Hotel           @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  roomType      RoomType        @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  lastCleanedBy User?           @relation("LastCleanedBy", fields: [lastCleanedById], references: [id], onDelete: SetNull)
  statusLogs    RoomStatusLog[]
  reservations  Reservation[]

  @@unique([hotelId, number])
  @@index([hotelId, status])
  @@index([roomTypeId])
  @@map("rooms")
}

/// Historial de cambios de estado. Si el cambio termina una limpieza
/// (CLEANING → AVAILABLE), guarda quién limpió y cuándo.
model RoomStatusLog {
  id                   String     @id @default(uuid()) @db.Uuid
  hotelId              String     @map("hotel_id") @db.Uuid
  roomId               String     @map("room_id") @db.Uuid
  fromStatus           RoomStatus @map("from_status")
  toStatus             RoomStatus @map("to_status")
  reason               String?
  changedById          String     @map("changed_by_id") @db.Uuid
  cleanedById          String?    @map("cleaned_by_id") @db.Uuid
  cleanedAt            DateTime?  @map("cleaned_at")
  /// Fecha estimada de fin indicada en este cambio. Si fromStatus = toStatus,
  /// el registro es un ajuste de fecha (previousBlockedUntil → blockedUntil).
  blockedUntil         DateTime?  @map("blocked_until") @db.Date
  previousBlockedUntil DateTime?  @map("previous_blocked_until") @db.Date
  createdAt            DateTime   @default(now()) @map("created_at")

  hotel     Hotel @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  room      Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  changedBy User  @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  cleanedBy User? @relation("CleanedBy", fields: [cleanedById], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@index([hotelId, cleanedAt])
  @@map("room_status_logs")
}

enum DocumentType {
  INE
  PASSPORT
  DRIVER_LICENSE
  OTHER

  @@map("document_type")
}

/// Huésped titular. No se borra (conserva su historial de estancias).
model Guest {
  id                String        @id @default(uuid()) @db.Uuid
  hotelId           String        @map("hotel_id") @db.Uuid
  firstName         String        @map("first_name")
  lastName          String        @map("last_name")
  birthDate         DateTime?     @map("birth_date") @db.Date
  /// Código de país ISO 3166-1 alfa-2 (p. ej. MX, US).
  nationality       String?       @db.Char(2)
  phone             String?
  email             String?
  documentType      DocumentType? @map("document_type")
  documentNumber    String?       @map("document_number")
  /// Procedencia (lo que pide la tarjeta de registro; no la dirección).
  city              String?
  state             String?
  country           String?       @db.Char(2)
  isVip             Boolean       @default(false) @map("is_vip")
  isBlocked         Boolean       @default(false) @map("is_blocked")
  blockedReason     String?       @map("blocked_reason")
  notes             String?
  privacyAcceptedAt DateTime?     @map("privacy_accepted_at")
  /// Texto normalizado (sin acentos, minúsculas) para la búsqueda rápida.
  searchText        String        @default("") @map("search_text")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  hotel        Hotel             @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  taxProfiles  GuestTaxProfile[]
  reservations Reservation[]

  @@unique([hotelId, documentType, documentNumber])
  @@index([hotelId, lastName])
  @@map("guests")
}

/// Datos fiscales para facturar (CFDI 4.0). Un huésped puede tener varios.
model GuestTaxProfile {
  id           String   @id @default(uuid()) @db.Uuid
  hotelId      String   @map("hotel_id") @db.Uuid
  guestId      String   @map("guest_id") @db.Uuid
  rfc          String   @db.VarChar(13)
  /// Razón social o nombre, tal como aparece en la constancia fiscal.
  legalName    String   @map("legal_name")
  /// Clave del catálogo c_RegimenFiscal del SAT (p. ej. 612).
  taxRegime    String   @map("tax_regime") @db.VarChar(3)
  /// Código postal del domicilio fiscal.
  zipCode      String   @map("zip_code") @db.Char(5)
  /// Clave del catálogo c_UsoCFDI del SAT (p. ej. G03).
  cfdiUse      String   @default("G03") @map("cfdi_use") @db.VarChar(4)
  invoiceEmail String?  @map("invoice_email")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  guest        Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([guestId, rfc])
  @@index([hotelId, rfc])
  @@map("guest_tax_profiles")
}

enum StayModality {
  NIGHTLY
  DAILY
  HOURLY

  @@map("stay_modality")
}

enum ReservationStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW

  @@map("reservation_status")
}

enum ReservationSource {
  WALK_IN
  PHONE
  WHATSAPP
  OTHER

  @@map("reservation_source")
}

/// Reserva por tipo de habitación; la habitación se asigna al llegar.
/// El precio se congela al reservar (no cambia si después cambian las tarifas).
model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  hotelId         String            @map("hotel_id") @db.Uuid
  /// Folio legible, consecutivo por hotel (R-000123).
  code            String
  guestId         String            @map("guest_id") @db.Uuid
  roomTypeId      String            @map("room_type_id") @db.Uuid
  /// Se asigna en el check-in.
  roomId          String?           @map("room_id") @db.Uuid
  modality        StayModality
  checkIn         DateTime          @map("check_in") @db.Timestamptz(3)
  checkOut        DateTime          @map("check_out") @db.Timestamptz(3)
  /// Noches, días u horas reservadas según la modalidad.
  units           Int
  adults          Int
  children        Int               @default(0)
  source          ReservationSource
  status          ReservationStatus @default(CONFIRMED)
  requiresDeposit Boolean           @default(false) @map("requires_deposit")
  notes           String?
  taxProfileId    String?           @map("tax_profile_id") @db.Uuid

  // Precio congelado (pesos enteros, impuestos incluidos).
  nightlyRate  Int  @map("nightly_rate")
  baseAmount   Int  @map("base_amount")
  extrasAmount Int  @map("extras_amount")
  totalAmount  Int  @map("total_amount")
  /// Detalle del cálculo (semanas, horas cobradas, tope, impuestos…).
  pricing      Json

  createdById      String    @map("created_by_id") @db.Uuid
  cancelledAt      DateTime? @map("cancelled_at")
  cancelledById    String?   @map("cancelled_by_id") @db.Uuid
  cancelReason     String?   @map("cancel_reason")
  noShowAt         DateTime? @map("no_show_at")
  checkedInAt      DateTime? @map("checked_in_at")
  checkedInById    String?   @map("checked_in_by_id") @db.Uuid
  checkedOutAt     DateTime? @map("checked_out_at")
  checkedOutById   String?   @map("checked_out_by_id") @db.Uuid
  /// Tipo reservado originalmente (si hubo mejora de categoría).
  bookedRoomTypeId String?   @map("booked_room_type_id") @db.Uuid
  upgradeReason    String?   @map("upgrade_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  hotel          Hotel            @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  guest          Guest            @relation(fields: [guestId], references: [id], onDelete: Restrict)
  roomType       RoomType         @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  room           Room?            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  taxProfile     GuestTaxProfile? @relation(fields: [taxProfileId], references: [id], onDelete: SetNull)
  createdBy      User             @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy    User?            @relation("ReservationCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  checkedInBy    User?            @relation("ReservationCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  checkedOutBy   User?            @relation("ReservationCheckedOutBy", fields: [checkedOutById], references: [id], onDelete: SetNull)
  bookedRoomType RoomType?        @relation("BookedRoomType", fields: [bookedRoomTypeId], references: [id], onDelete: SetNull)
  charges        StayCharge[]

  @@unique([hotelId, code])
  @@index([hotelId, roomTypeId, checkIn, checkOut])
  @@index([hotelId, status])
  @@index([guestId])
  @@index([hotelId, roomId, status])
  @@map("reservations")
}

/// Temporada: ajuste porcentual del precio por noche entre dos fechas
/// (inclusive). Si aplica, el ajuste por día de la semana no se suma.
model RatePeriod {
  id                String   @id @default(uuid()) @db.Uuid
  hotelId           String   @map("hotel_id") @db.Uuid
  name              String
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  /// Ajuste en %: 30 = +30 %, -15 = 15 % de descuento.
  adjustmentPercent Int      @map("adjustment_percent")
  /// Si dos temporadas se enciman gana la de mayor prioridad.
  priority          Int      @default(0)
  color             String   @default("violet")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, startDate, endDate])
  @@map("rate_periods")
}

enum StayChargeKind {
  EARLY_CHECK_IN
  LATE_CHECK_OUT

  @@map("stay_charge_kind")
}

enum StayChargeStatus {
  /// Calculado por el sistema; se confirma o condona al cobrar (Fase 7).
  SUGGESTED
  CONFIRMED
  WAIVED

  @@map("stay_charge_status")
}

/// Cargo adicional de una estancia (entrada anticipada, salida tardía…).
model StayCharge {
  id            String           @id @default(uuid()) @db.Uuid
  hotelId       String           @map("hotel_id") @db.Uuid
  reservationId String           @map("reservation_id") @db.Uuid
  kind          StayChargeKind
  status        StayChargeStatus @default(SUGGESTED)
  description   String
  /// Horas cobradas (después de la tolerancia).
  hours         Int
  /// Pesos enteros, impuestos incluidos.
  amount        Int
  createdById   String           @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  hotel       Hotel       @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@map("stay_charges")
}
